<%#
  Renders one table cell. A YAML value can be any of three shapes:

    scalar      seguro: Não
    record      { text:, subtext:, url:, alt:, source: }
    collection  a list of records (used by `observacoes`)
%>
<% if cell.kind_of? Sitepress::Data::Collection %>
  <ul class="space-y-2 text-xs text-left">
    <% cell.each do |entry| %>
      <li>
        <%= entry["text"] %>
        <%= render "partials/source_link", source: entry["source"] %>
      </li>
    <% end %>
  </ul>

<% elsif cell.kind_of? Sitepress::Data::Record %>
  <div class="flex flex-wrap items-center justify-center gap-1">
    <%= render "partials/verdict", text: cell["text"] %>
    <% if cell["url"] %>
      <a href="<%= cell["url"] %>" rel="noopener noreferrer" target="_blank"><%= cell["text"] %></a>
    <% elsif !cell["text"].nil? %>
      <span><%= render "partials/verdict_label", text: cell["text"] %></span>
    <% end %>
    <%= render "partials/note", note: cell["alt"] %>
  </div>

  <% if cell["subtext"] || cell["source"] %>
    <div class="flex flex-wrap items-center justify-center gap-1 mt-0.5 text-xs text-gray-500 dark:text-gray-400">
      <% if cell["subtext"] %>
        <span><%= cell["subtext"] %></span>
      <% end %>
      <%= render "partials/source_link", source: cell["source"] %>
    </div>
  <% end %>

<% else %>
  <div class="flex items-center justify-center gap-1">
    <%= render "partials/verdict", text: cell %>
    <%= render "partials/verdict_label", text: cell %>
  </div>
<% end %>
